{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "enabled_providers": [
    "private_gateway"
  ],
  "agents": {
    "quick": {
      "description": "Fast, concise answers through the private AI gateway",
      "mode": "primary",
      "system": "You are a fast, concise coding assistant. Keep responses short and actionable. Prioritize speed over exhaustive detail."
    },
    "pro": {
      "description": "Expert coding agent for complex architecture, debugging, and deep code analysis",
      "mode": "primary",
      "system": "You are an expert software engineer. Think deeply before acting. Use extended reasoning for complex problems. Focus on correctness, edge cases, and production-quality code. When debugging, be methodical and trace through the full execution path."
    },
    "ui-balanced": {
      "description": "UI/UX work, balanced mode: Gemini 4 Argon (high)",
      "mode": "primary",
      "model": "private_gateway/gemini-4-argon#high",
      "system": "You are a frontend and UI/UX specialist. Focus on component architecture, responsive design, accessibility, and visual polish. Leverage your multimodal capabilities to understand design references, screenshots, and mockups. Prefer modern patterns: CSS Grid/Flexbox, design tokens, component composition."
    },
    "ui-intelligence": {
      "description": "UI/UX work, intelligence mode: Claude Fable 5.1 at medium reasoning effort",
      "mode": "primary",
      "model": "private_gateway/claude-fable-5-1#medium",
      "system": "You are a frontend and UI/UX specialist. Focus on component architecture, responsive design, accessibility, and visual polish. Leverage your multimodal capabilities to understand design references, screenshots, and mockups. Prefer modern patterns: CSS Grid/Flexbox, design tokens, component composition."
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.envrc": "deny",
      "**/secrets.yaml": "deny",
      "**/secrets.yml": "deny",
      "**/secret.yaml": "deny",
      "**/secret.yml": "deny",
      "**/credentials.json": "deny",
      "**/credentials.yaml": "deny",
      "**/service-account*.json": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.asc": "deny",
      "**/*.tfvars": "deny",
      "**/*.tfstate": "deny",
      "**/*.tfstate.backup": "deny",
      "**/.terraform/**": "deny",
      "**/.npmrc": "deny",
      "**/.yarnrc.yml": "deny",
      "**/hosts.yml": "deny",
      "**/.env.example": "allow",
      "**/*.env.example": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.envrc": "deny",
      "**/secrets.yaml": "deny",
      "**/secrets.yml": "deny",
      "**/secret.yaml": "deny",
      "**/secret.yml": "deny",
      "**/credentials.json": "deny",
      "**/credentials.yaml": "deny",
      "**/service-account*.json": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.asc": "deny",
      "**/*.tfvars": "deny",
      "**/*.tfstate": "deny",
      "**/*.tfstate.backup": "deny",
      "**/.terraform/**": "deny",
      "**/.npmrc": "deny",
      "**/.yarnrc.yml": "deny",
      "**/hosts.yml": "deny",
      "**/.env.example": "allow",
      "**/*.env.example": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "sudo *": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "git push *": "ask",
      "git reset --hard*": "ask",
      "terraform apply*": "ask",
      "terraform destroy*": "ask",
      "az group delete*": "ask",
      "gcloud projects delete*": "ask"
    },
    "external_directory": {
      "*": "allow",
      "~/.ssh/id_*": "deny",
      "~/.ssh/*_rsa": "deny",
      "~/.ssh/*_ed25519": "deny",
      "~/.ssh/*_ecdsa": "deny",
      "~/.ssh/*_dsa": "deny",
      "~/.ssh/authorized_keys": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/credentials": "deny",
      "~/.aws/config": "deny",
      "~/.aws/sso/**": "deny",
      "~/.azure/**": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.config/op/**": "deny",
      "~/.config/1Password/**": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.config/git/credentials": "deny",
      "~/.config/rclone/rclone.conf": "deny",
      "~/.docker/config.json": "deny",
      "~/.kube/config": "deny",
      "~/.netrc": "deny",
      "~/.npmrc": "deny",
      "~/.pypirc": "deny",
      "~/.password-store/**": "deny",
      "~/.terraform.d/credentials.tfrc.json": "deny",
      "~/.git-credentials": "deny",
      "~/.vault-token": "deny",
      "~/.age/**": "deny",
      "~/.config/doctl/**": "deny",
      "~/.config/netlify/**": "deny",
      "~/.config/fly/**": "deny",
      "~/.config/heroku/credentials.json": "deny",
      "~/.codex/auth.json": "deny",
      "/mnt/c/Users/*/.ssh/**": "deny",
      "/mnt/c/Users/*/.aws/**": "deny",
      "/mnt/c/Users/*/.azure/**": "deny",
      "/mnt/c/Users/*/AppData/Local/1Password/**": "deny",
      "/mnt/wsl/**": "deny"
    }
  }
}
