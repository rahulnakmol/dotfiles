{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/claude-sonnet-4-6",
  "small_model": "opencode/gpt-5-nano",
  "autoupdate": false,
  "enabled_providers": [
    "opencode"
  ],
  "agent": {
    "quick": {
      "description": "Fast queries using cheap/free models (GLM-5, Kimi K2.5, MiniMax M2.5, Gemini Flash)",
      "mode": "primary",
      "model": "opencode/minimax-m2.5",
      "prompt": "You are a fast, concise coding assistant. Keep responses short and actionable. Prioritize speed over exhaustive detail."
    },
    "pro": {
      "description": "Expert coding agent using premium thinking/reasoning models (Opus, GPT Codex) for complex architecture, debugging, and deep code analysis",
      "mode": "primary",
      "model": "opencode/claude-opus-4-6",
      "prompt": "You are an expert software engineer. Think deeply before acting. Use extended reasoning for complex problems. Focus on correctness, edge cases, and production-quality code. When debugging, be methodical and trace through the full execution path."
    },
    "ui": {
      "description": "UI/UX focused agent using Gemini Pro for frontend, design systems, layout, and visual work with multimodal support",
      "mode": "primary",
      "model": "opencode/gemini-3.1-pro",
      "prompt": "You are a frontend and UI/UX specialist. Focus on component architecture, responsive design, accessibility, and visual polish. Leverage your multimodal capabilities to understand design references, screenshots, and mockups. Prefer modern patterns: CSS Grid/Flexbox, design tokens, component composition."
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.envrc": "deny",
      "**/secrets.yaml": "deny",
      "**/secrets.yml": "deny",
      "**/secret.yaml": "deny",
      "**/secret.yml": "deny",
      "**/credentials.json": "deny",
      "**/credentials.yaml": "deny",
      "**/service-account*.json": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.asc": "deny",
      "**/*.tfvars": "deny",
      "**/*.tfstate": "deny",
      "**/*.tfstate.backup": "deny",
      "**/.terraform/**": "deny",
      "**/.npmrc": "deny",
      "**/.yarnrc.yml": "deny",
      "**/hosts.yml": "deny",
      "**/.env.example": "allow",
      "**/*.env.example": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.envrc": "deny",
      "**/secrets.yaml": "deny",
      "**/secrets.yml": "deny",
      "**/secret.yaml": "deny",
      "**/secret.yml": "deny",
      "**/credentials.json": "deny",
      "**/credentials.yaml": "deny",
      "**/service-account*.json": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/*.asc": "deny",
      "**/*.tfvars": "deny",
      "**/*.tfstate": "deny",
      "**/*.tfstate.backup": "deny",
      "**/.terraform/**": "deny",
      "**/.npmrc": "deny",
      "**/.yarnrc.yml": "deny",
      "**/hosts.yml": "deny",
      "**/.env.example": "allow",
      "**/*.env.example": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "sudo *": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "git push *": "ask",
      "git reset --hard*": "ask",
      "terraform apply*": "ask",
      "terraform destroy*": "ask",
      "az group delete*": "ask",
      "gcloud projects delete*": "ask"
    },
    "external_directory": {
      "*": "allow",
      "~/.ssh/id_*": "deny",
      "~/.ssh/*_rsa": "deny",
      "~/.ssh/*_ed25519": "deny",
      "~/.ssh/*_ecdsa": "deny",
      "~/.ssh/*_dsa": "deny",
      "~/.ssh/authorized_keys": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/credentials": "deny",
      "~/.aws/config": "deny",
      "~/.aws/sso/**": "deny",
      "~/.azure/**": "deny",
      "~/.config/gcloud/**": "deny",
      "~/.config/op/**": "deny",
      "~/.config/1Password/**": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.config/git/credentials": "deny",
      "~/.config/rclone/rclone.conf": "deny",
      "~/.docker/config.json": "deny",
      "~/.kube/config": "deny",
      "~/.netrc": "deny",
      "~/.npmrc": "deny",
      "~/.pypirc": "deny",
      "~/.password-store/**": "deny",
      "~/.terraform.d/credentials.tfrc.json": "deny",
      "~/.git-credentials": "deny",
      "~/.vault-token": "deny",
      "~/.age/**": "deny",
      "~/.config/doctl/**": "deny",
      "~/.config/netlify/**": "deny",
      "~/.config/fly/**": "deny",
      "~/.config/heroku/credentials.json": "deny",
      "~/.codex/auth.json": "deny",
      "/mnt/c/Users/*/.ssh/**": "deny",
      "/mnt/c/Users/*/.aws/**": "deny",
      "/mnt/c/Users/*/.azure/**": "deny",
      "/mnt/c/Users/*/AppData/Local/1Password/**": "deny",
      "/mnt/wsl/**": "deny"
    }
  }
}
