# HTTPS credential helper via gh. Bare `gh` so PATH resolves it regardless of
# whether it came from apt, dnf, zypper, or Homebrew — never hardcode an
# absolute path here (that broke on any box where gh wasn't at that path).
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
