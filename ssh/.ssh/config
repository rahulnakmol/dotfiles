# 1Password SSH agent — claimed only when the agent socket actually exists.
# An unconditional IdentityAgent here breaks ssh entirely on any box where
# 1Password isn't running (agent forwarding fails outright rather than
# falling back to a default identity). %d is OpenSSH's token for the local
# user's home directory. Works identically on native Linux (1Password app)
# and WSL (the socket bridged from Windows in 10-wsl.zsh).
Match host * exec "test -S %d/.1password/agent.sock"
    IdentityAgent ~/.1password/agent.sock
